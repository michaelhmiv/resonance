{
  "expo": {
    "name": "Resonance",
    "slug": "resonance",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "scheme": "resonance",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#E9E7D3"
      },
      "package": "com.resonance.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#E9E7D3",
          "imageWidth": 200
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/CormorantGaramond_400Regular.ttf",
            "./assets/fonts/CormorantGaramond_500Medium.ttf",
            "./assets/fonts/CormorantGaramond_400Regular_Italic.ttf",
            "./assets/fonts/CormorantGaramond_600SemiBold.ttf",
            "./assets/fonts/Inter_400Regular.ttf",
            "./assets/fonts/Inter_500Medium.ttf",
            "./assets/fonts/Inter_600SemiBold.ttf"
          ]
        }
      ],
      "expo-sqlite"
    ]
  }
}
