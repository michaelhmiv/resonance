{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@resonance/core": [
        "../../packages/core/src"
      ],
      "@resonance/core/*": [
        "../../packages/core/src/*"
      ],
      "@resonance/theme": [
        "../../packages/theme/src"
      ],
      "@resonance/theme/*": [
        "../../packages/theme/src/*"
      ],
      "@resonance/ui": [
        "../../packages/ui/src"
      ],
      "@resonance/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@resonance/screens": [
        "../../packages/screens/src"
      ],
      "@resonance/screens/*": [
        "../../packages/screens/src/*"
      ]
    },
    "baseUrl": ".",
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/core/src/**/*.ts",
    "../../packages/theme/src/**/*.ts",
    "../../packages/ui/src/**/*.tsx",
    "../../packages/ui/src/**/*.ts",
    "../../packages/screens/src/**/*.ts",
    "../../packages/screens/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
