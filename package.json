{
  "name": "resonance",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "cd apps/web && npm start",
    "dev": "cd apps/web && npm run dev",
    "build": "cd apps/web && npm run build",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/theme/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json && tsc --noEmit -p packages/screens/tsconfig.json && tsc --noEmit -p apps/mobile/tsconfig.json",
    "typecheck:mobile": "tsc --noEmit -p apps/mobile/tsconfig.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck:packages": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/theme/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json && tsc --noEmit -p packages/screens/tsconfig.json",
    "verify:resonance-hotpath": "node scripts/verify-resonance-hotpath.mjs",
    "verify:journal-loading": "node scripts/verify-journal-loading-contract.mjs",
    "verify:persistent-resonance": "node scripts/verify-persistent-resonance-contract.mjs",
    "prewarm:journal-resonance": "node scripts/prewarm-journal-resonance.mjs",
    "verify:adaptive-resonance": "node scripts/verify-adaptive-resonance-contract.mjs",
    "simulate:adaptive-resonance": "node scripts/simulate-adaptive-resonance-live.mjs"
  },
  "version": "2.0.0",
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-native": "^0.72.8",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2"
  }
}
